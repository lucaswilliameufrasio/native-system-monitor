import { LineEdit, ListView, VerticalBox } from "std-widgets.slint";

export struct ProcessRow {
    key: string,
    name: string,
    pid: string,
    parent-pid: string,
    started: string,
    cpu: string,
    memory: string,
    memory-unit: string,
    memory-percent: string,
}

export struct ProcessTreeRow {
    label: string,
    depth: int,
}

export struct CpuCoreRow {
    name: string,
    usage: string,
    fraction: float,
}

export struct VolumeRow {
    mount-point: string,
    file-system: string,
    total: string,
    available: string,
    read-rate: string,
    write-rate: string,
}

export struct NetworkInterfaceRow {
    name: string,
    kind: string,
    received: string,
    transmitted: string,
}

export struct BlockDeviceRow {
    name: string,
    read-rate: string,
    write-rate: string,
    read-iops: string,
    write-iops: string,
    read-latency: string,
    write-latency: string,
    busy: string,
}

export struct GpuRow {
    name: string,
    utilization: string,
    memory: string,
    temperature: string,
    clocks: string,
    power: string,
}

enum MainPage { overview, processes, performance, storage, network }
enum HistoryRange { one-minute, five-minutes }
export enum UiLanguage { pt_br, en_us }
export enum UiDensity { comfortable, compact }
export enum UiByteUnitSystem { si, iec }
export enum ProcessActionUiState {
    idle,
    confirm_gentle,
    sending_gentle,
    waiting_gentle,
    confirm_force,
    sending_force,
    finished,
}

component MetricPanel inherits Rectangle {
    min-width: 0px;
    in property <string> title;
    in property <string> value;
    in property <string> detail;
    in property <color> accent;
    accessible-role: groupbox;
    accessible-label: title;
    background: #19212b;
    border-color: #2c3744;
    border-width: 1px;
    border-radius: 8px;

    VerticalBox {
        padding: 14px;
        spacing: 5px;
        Text { text: title; color: #9eacbd; font-size: 13px; }
        Text { text: value; color: accent; font-size: 22px; }
        Text { text: detail; accessible-label: detail; color: #8493a5; font-size: 12px; overflow: elide; }
    }
}

component NavigationItem inherits FocusScope {
    in property <string> label;
    in property <bool> active;
    in property <bool> compact;
    in property <int> index;
    callback activated();
    callback navigation-key-requested(int, int);
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selectable: true;
    accessible-item-selected: active;
    accessible-action-default => { root.activated(); }
    focus-on-tab-navigation: true;
    height: compact ? 34px : 42px;

    KeyBinding {
        keys: @keys(Return);
        activated => { root.activated(); }
    }
    KeyBinding {
        keys: @keys(Space);
        activated => { root.activated(); }
    }
    KeyBinding {
        keys: @keys(UpArrow);
        activated => { root.navigation-key-requested(root.index, -1); }
    }
    KeyBinding {
        keys: @keys(LeftArrow);
        activated => { root.navigation-key-requested(root.index, -1); }
    }
    KeyBinding {
        keys: @keys(DownArrow);
        activated => { root.navigation-key-requested(root.index, 1); }
    }
    KeyBinding {
        keys: @keys(RightArrow);
        activated => { root.navigation-key-requested(root.index, 1); }
    }
    KeyBinding {
        keys: @keys(Home);
        activated => { root.navigation-key-requested(root.index, -2); }
    }
    KeyBinding {
        keys: @keys(End);
        activated => { root.navigation-key-requested(root.index, 2); }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 6px;
        border-color: root.has-focus ? #7db6ff : transparent;
        border-width: root.has-focus ? 2px : 0px;
        background: root.active ? #263a4c : transparent;

        Text {
            x: 14px;
            width: parent.width - 28px;
            height: parent.height;
            text: root.label;
            color: root.active ? #eaf3fc : #a6b3c2;
            font-size: 14px;
            vertical-alignment: center;
        }
        TouchArea { clicked => { root.activated(); } }
    }
}

component RangeChoice inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback activated();
    accessible-role: radio-button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: active;
    accessible-action-default => { root.activated(); }
    width: 72px;
    height: 30px;
    border-radius: 5px;
    background: active ? #28425a : #19212b;
    border-color: active ? #47749a : #2c3744;
    border-width: 1px;

    Text {
        width: parent.width;
        height: parent.height;
        text: label;
        color: active ? #edf6ff : #a6b3c2;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.activated(); } }
}

component SortHeader inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <string> active-key;
    in property <bool> descending;
    in property <string> unsorted-description;
    in property <string> ascending-description;
    in property <string> descending-description;
    callback requested(string);
    accessible-role: button;
    accessible-label: label;
    accessible-description: active-key == key
        ? (descending ? descending-description : ascending-description)
        : unsorted-description;
    accessible-action-default => { root.requested(root.key); }
    min-width: 0px;
    height: 28px;
    background: transparent;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label + (root.active-key == root.key ? (root.descending ? "  ↓" : "  ↑") : "");
        color: root.active-key == root.key ? #dce9f6 : #9eacbd;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: root.key == "name" ? left : right;
        overflow: elide;
    }
    TouchArea { clicked => { root.requested(root.key); } }
}

component ProcessActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> destructive;
    callback activated();
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }
    min-width: 100px;
    height: 30px;
    border-radius: 5px;
    background: destructive ? #5a292d : #28425a;
    border-color: destructive ? #8a4147 : #47749a;
    border-width: 1px;

    Text {
        width: parent.width - 12px;
        x: 6px;
        height: parent.height;
        text: root.label;
        color: #f2f5f8;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea { clicked => { root.activated(); } }
}

component ChartPanel inherits Rectangle {
    in property <string> accessible-summary;
    accessible-role: image;
    accessible-label: accessible-summary;
    min-width: 0px;
    in property <string> title;
    in property <[float]> points;
    in property <color> accent;
    in property <string> range-start;
    in property <string> now-label;
    in property <string> waiting-label;
    background: #19212b;
    border-color: #2c3744;
    border-width: 1px;
    border-radius: 8px;

    VerticalBox {
        padding: 14px;
        spacing: 8px;

        HorizontalLayout {
            height: 24px;
            Text { text: title; color: #e4ebf3; font-size: 14px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: "%"; color: #8b9aae; font-size: 12px; vertical-alignment: center; }
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            VerticalBox {
                width: 34px;
                Text { text: "100"; color: #8190a2; font-size: 10px; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: "50"; color: #8190a2; font-size: 10px; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: "0"; color: #8190a2; font-size: 10px; }
            }

            Rectangle {
                background: #121922;
                border-radius: 4px;
                horizontal-stretch: 1;
                vertical-stretch: 1;

                if points.length == 0: Text {
                    width: parent.width;
                    height: parent.height;
                    text: waiting-label;
                    accessible-label: waiting-label;
                    color: #8493a5;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if points.length > 0: HorizontalLayout {
                    x: 5px;
                    y: 5px;
                    width: parent.width - 10px;
                    height: parent.height - 10px;
                    spacing: 2px;
                    for point in points: Rectangle {
                        min-width: 1px;
                        horizontal-stretch: 1;
                        height: parent.height;
                        background: transparent;
                        Rectangle {
                            y: parent.height * (1 - point / 100);
                            width: parent.width;
                            height: parent.height * point / 100;
                            background: accent;
                            border-radius: 2px;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 18px;
            Text { text: range-start; accessible-label: range-start; color: #8190a2; font-size: 10px; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: now-label; accessible-label: now-label; color: #8190a2; font-size: 10px; }
        }
    }
}

export component MainWindow inherits Window {
    forward-focus: keyboard-shortcuts;
    in-out property <UiLanguage> language: UiLanguage.pt_br;
    in-out property <UiDensity> density: UiDensity.comfortable;
    in-out property <UiByteUnitSystem> byte-unit-system: UiByteUnitSystem.iec;
    in-out property <string> header-title: "";
    in-out property <string> header-tagline: "";
    in-out property <string> header-language-pt-br-accessible-label: "";
    in-out property <string> header-language-en-us-accessible-label: "";
    in-out property <string> header-language-pt-br-short-label: "";
    in-out property <string> header-language-en-us-short-label: "";
    in-out property <string> agent-active-label: "";
    in-out property <string> agent-unavailable-label: "";
    in-out property <string> setup-startup-label: "";
    in-out property <string> retry-connection-label: "";
    in-out property <string> nav-section-label: "";
    in-out property <string> nav-accessible-label: "";
    in-out property <string> nav-overview-label: "";
    in-out property <string> nav-processes-label: "";
    in-out property <string> nav-performance-label: "";
    in-out property <string> nav-storage-label: "";
    in-out property <string> nav-network-label: "";
    in-out property <string> nav-collection-continues-label: "";
    in-out property <string> nav-keyboard-shortcut-label: "";
    in-out property <string> nav-keyboard-shortcut-accessible-label: "";
    in-out property <string> density-comfortable-label: "";
    in-out property <string> density-comfortable-accessible-label: "";
    in-out property <string> density-compact-label: "";
    in-out property <string> density-compact-accessible-label: "";
    in-out property <string> overview-live-updates-label: "";
    in-out property <string> overview-total-cpu-label: "";
    in-out property <string> overview-memory-label: "";
    in-out property <string> overview-swap-label: "";
    in-out property <string> overview-processes-label: "";
    in-out property <string> overview-battery-label: "";
    in-out property <string> overview-cpu-usage-label: "";
    in-out property <string> overview-memory-usage-label: "";
    in-out property <string> performance-one-minute-label: "";
    in-out property <string> performance-five-minutes-label: "";
    in-out property <string> performance-cpu-total-label: "";
    in-out property <string> performance-memory-used-label: "";
    in-out property <string> performance-cpu-per-core-label: "";
    in-out property <string> performance-cpu-unavailable-label: "";
    in-out property <string> performance-gpu-vram-label: "";
    in-out property <string> chart-now-label: "";
    in-out property <string> chart-waiting-label: "";
    in-out property <string> storage-units-label: "";
    in-out property <string> storage-si-accessible-label: "";
    in-out property <string> storage-iec-accessible-label: "";
    in-out property <string> storage-mount-point-label: "";
    in-out property <string> storage-read-label: "";
    in-out property <string> storage-write-label: "";
    in-out property <string> storage-file-system-label: "";
    in-out property <string> storage-available-label: "";
    in-out property <string> storage-total-label: "";
    in-out property <string> storage-block-activity-label: "";
    in-out property <string> storage-device-label: "";
    in-out property <string> storage-read-iops-label: "";
    in-out property <string> storage-write-iops-label: "";
    in-out property <string> storage-busy-label: "";
    in-out property <string> network-interface-label: "";
    in-out property <string> network-kind-label: "";
    in-out property <string> network-received-label: "";
    in-out property <string> network-sent-label: "";
    in-out property <string> process-list-title-label: "";
    in-out property <string> process-filter-placeholder: "";
    in-out property <string> process-filter-accessible-label: "";
    in-out property <string> process-column-label: "";
    in-out property <string> process-pid-label: "";
    in-out property <string> process-parent-pid-label: "";
    in-out property <string> process-cpu-label: "";
    in-out property <string> process-sort-unsorted-description: "";
    in-out property <string> process-sort-ascending-description: "";
    in-out property <string> process-sort-descending-description: "";
    in-out property <string> process-empty-filtered-label: "";
    in-out property <string> process-waiting-connection-label: "";
    in-out property <string> process-started-label: "";
    in-out property <string> process-memory-label: "";
    in-out property <string> process-memory-accessible-label: "";
    in-out property <string> process-select-prompt-label: "";
    in-out property <string> process-tree-title-label: "";
    in-out property <bool> process-control-supported: false;
    in-out property <ProcessActionUiState> process-action-state: ProcessActionUiState.idle;
    in-out property <string> process-action-status: "";
    in-out property <string> process-action-request-label: "";
    in-out property <string> process-action-confirm-label: "";
    in-out property <string> process-action-force-label: "";
    in-out property <string> process-action-cancel-label: "";
    in-out property <string> process-action-stop-escalation-label: "";
    in-out property <string> process-action-dismiss-label: "";
    title: header-title;
    preferred-width: 1120px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 600px;
    background: #11161d;

    in-out property <string> agent-status: "";
    in-out property <bool> agent-connected: false;
    in-out property <bool> agent-startup-configured: false;
    in-out property <string> sample-age: "";
    in-out property <string> cpu-value: "—";
    in-out property <string> cpu-status: "";
    in-out property <string> memory-value: "—";
    in-out property <string> memory-status: "";
    in-out property <string> swap-value: "—";
    in-out property <string> swap-status: "";
    in-out property <string> process-count: "—";
    in-out property <string> process-count-description: "—";
    in-out property <string> process-count-detail: "";
    in-out property <string> volume-count: "—";
    in-out property <string> network-interface-count: "—";
    in-out property <string> sort-key: "cpu";
    in-out property <bool> sort-descending: true;
    in-out property <string> cpu-history-start-label: "";
    in-out property <string> memory-history-start-label: "";
    in-out property <string> cpu-history-accessible-summary: "";
    in-out property <string> memory-history-accessible-summary: "";
    in-out property <string> selected-process-key: "";
    in-out property <bool> has-selected-process: false;
    in-out property <string> selected-process-name: "";
    in-out property <string> selected-process-pid: "—";
    in-out property <string> selected-process-parent-pid: "—";
    in-out property <string> selected-process-started: "—";
    in-out property <string> selected-process-cpu: "—";
    in-out property <string> selected-process-memory: "—";
    in-out property <string> selected-process-memory-unit: "MiB";
    in-out property <string> selected-process-memory-percent: "—";
    in-out property <[ProcessTreeRow]> process-tree: [];
    in-out property <string> process-tree-status: "";
    in-out property <[ProcessRow]> processes: [];
    in-out property <[CpuCoreRow]> cpu-cores: [];
    in-out property <[VolumeRow]> volumes: [];
    in-out property <string> volume-status: "";
    in-out property <[NetworkInterfaceRow]> network-interfaces: [];
    in-out property <string> network-status: "";
    in-out property <[BlockDeviceRow]> block-devices: [];
    in-out property <[GpuRow]> gpus: [];
    in-out property <string> gpu-status: "";
    in-out property <string> battery-value: "—";
    in-out property <string> battery-status: "";
    in-out property <string> block-device-io-status: "";
    in-out property <[float]> cpu-history: [];
    in-out property <[float]> memory-history: [];
    in-out property <MainPage> active-page: MainPage.overview;
    in-out property <HistoryRange> history-range: HistoryRange.five-minutes;
    callback filter-edited(string);
    callback sort-requested(string);
    callback process-selected(string);
    callback process-action-command(string);
    callback history-range-selected(string);
    callback retry-agent();
    callback language-selected(string);
    callback byte-unit-system-selected(string);
    callback density-selected(string);

    function select-navigation-page(index: int) {
        if (index == 0) {
            root.active-page = MainPage.overview;
            navigation_overview.focus();
        } else if (index == 1) {
            root.active-page = MainPage.processes;
            navigation_processes.focus();
        } else if (index == 2) {
            root.active-page = MainPage.performance;
            navigation_performance.focus();
        } else if (index == 3) {
            root.active-page = MainPage.storage;
            navigation_storage.focus();
        } else {
            root.active-page = MainPage.network;
            navigation_network.focus();
        }
    }

    function move-navigation-focus(index: int, direction: int) {
        if (direction == -2) {
            root.select-navigation-page(0);
        } else if (direction == 2) {
            root.select-navigation-page(4);
        } else if (direction < 0) {
            if (index == 0) {
                root.select-navigation-page(4);
            } else {
                root.select-navigation-page(index - 1);
            }
        } else if (index == 4) {
            root.select-navigation-page(0);
        } else {
            root.select-navigation-page(index + 1);
        }
    }

    keyboard-shortcuts := FocusScope {
        focus-on-tab-navigation: false;
        width: parent.width;
        height: parent.height;

        KeyBinding {
            keys: @keys(Control + "1");
            activated => { root.active-page = MainPage.overview; }
        }
        KeyBinding {
            keys: @keys(Control + "2");
            activated => { root.active-page = MainPage.processes; }
        }
        KeyBinding {
            keys: @keys(Control + "3");
            activated => { root.active-page = MainPage.performance; }
        }
        KeyBinding {
            keys: @keys(Control + "4");
            activated => { root.active-page = MainPage.storage; }
        }
        KeyBinding {
            keys: @keys(Control + "5");
            activated => { root.active-page = MainPage.network; }
        }
        VerticalBox {
            width: parent.width;
            height: parent.height;
            padding: root.density == UiDensity.compact ? 12px : 18px;
            spacing: root.density == UiDensity.compact ? 9px : 14px;

            HorizontalLayout {
                height: 54px;
                spacing: 8px;

                VerticalBox {
                    width: 240px;
                    spacing: 2px;
                    Text { text: root.header-title; accessible-label: root.header-title; color: #edf2f7; font-size: 23px; }
                    Text { text: root.header-tagline; accessible-label: root.header-tagline; color: #8493a5; font-size: 11px; }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                VerticalBox {
                    width: 200px;
                    spacing: 2px;
                    Text {
                        text: agent-connected ? root.agent-active-label : root.agent-unavailable-label;
                        accessible-label: agent-status;
                        accessible-live-region: polite;
                        color: agent-connected && agent-startup-configured ? #77d7ad : #f0bd69;
                        font-size: 12px;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                    Text {
                        text: sample-age;
                        accessible-label: sample-age;
                        color: #8493a5;
                        font-size: 11px;
                        horizontal-alignment: right;
                    }
                }

                if !agent-connected || !agent-startup-configured: RangeChoice {
                    width: 112px;
                    label: agent-connected ? root.setup-startup-label : root.retry-connection-label;
                    active: false;
                    activated => { root.retry-agent(); }
                }
                language_pt_br := RangeChoice {
                    width: 44px;
                    label: root.header-language-pt-br-short-label;
                    active: root.language == UiLanguage.pt_br;
                    accessible-label: root.header-language-pt-br-accessible-label;
                    activated => { root.language-selected("pt-BR"); }
                }
                language_en_us := RangeChoice {
                    width: 44px;
                    label: root.header-language-en-us-short-label;
                    active: root.language == UiLanguage.en_us;
                    accessible-label: root.header-language-en-us-accessible-label;
                    activated => { root.language-selected("en-US"); }
                }
                density_comfortable := RangeChoice {
                    width: 86px;
                    label: root.density-comfortable-label;
                    active: root.density == UiDensity.comfortable;
                    accessible-label: root.density-comfortable-accessible-label;
                    activated => {
                        root.density = UiDensity.comfortable;
                        root.density-selected("comfortable");
                    }
                }
                density_compact := RangeChoice {
                    width: 74px;
                    label: root.density-compact-label;
                    active: root.density == UiDensity.compact;
                    accessible-label: root.density-compact-accessible-label;
                    activated => {
                        root.density = UiDensity.compact;
                        root.density-selected("compact");
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 14px;

                Rectangle {
                    width: 164px;
                    accessible-role: tab-list;
                    accessible-label: root.nav-accessible-label;
                    accessible-orientation: vertical;
                    accessible-item-count: 5;
                    background: #171e27;
                    border-color: #26313d;
                    border-width: 1px;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 10px;
                        spacing: 6px;
                        Text { text: root.nav-section-label; accessible-label: root.nav-section-label; color: #8292a5; font-size: 10px; }
                        navigation_overview := NavigationItem {
                            index: 0;
                            compact: root.density == UiDensity.compact;
                            label: root.nav-overview-label;
                            active: root.active-page == MainPage.overview;
                            activated => { root.active-page = MainPage.overview; }
                            navigation-key-requested(index, direction) => {
                                root.move-navigation-focus(index, direction);
                            }
                        }
                        navigation_processes := NavigationItem {
                            index: 1;
                            compact: root.density == UiDensity.compact;
                            label: root.nav-processes-label;
                            active: root.active-page == MainPage.processes;
                            activated => { root.active-page = MainPage.processes; }
                            navigation-key-requested(index, direction) => {
                                root.move-navigation-focus(index, direction);
                            }
                        }
                        navigation_performance := NavigationItem {
                            index: 2;
                            compact: root.density == UiDensity.compact;
                            label: root.nav-performance-label;
                            active: root.active-page == MainPage.performance;
                            activated => { root.active-page = MainPage.performance; }
                            navigation-key-requested(index, direction) => {
                                root.move-navigation-focus(index, direction);
                            }
                        }
                        navigation_storage := NavigationItem {
                            index: 3;
                            compact: root.density == UiDensity.compact;
                            label: root.nav-storage-label;
                            active: root.active-page == MainPage.storage;
                            activated => { root.active-page = MainPage.storage; }
                            navigation-key-requested(index, direction) => {
                                root.move-navigation-focus(index, direction);
                            }
                        }
                        navigation_network := NavigationItem {
                            index: 4;
                            compact: root.density == UiDensity.compact;
                            label: root.nav-network-label;
                            active: root.active-page == MainPage.network;
                            activated => { root.active-page = MainPage.network; }
                            navigation-key-requested(index, direction) => {
                                root.move-navigation-focus(index, direction);
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        Text {
                            text: root.nav-collection-continues-label;
                            accessible-label: root.nav-collection-continues-label;
                            color: #8292a5;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.nav-keyboard-shortcut-label;
                            accessible-label: root.nav-keyboard-shortcut-accessible-label;
                            color: #8292a5;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    accessible-role: main;
                    background: transparent;

                    if root.active-page == MainPage.overview: VerticalBox {
                        spacing: 12px;

                        HorizontalLayout {
                            height: 30px;
                            Text { text: root.nav-overview-label; accessible-label: root.nav-overview-label; color: #edf2f7; font-size: 19px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.overview-live-updates-label; accessible-label: root.overview-live-updates-label; color: #8493a5; font-size: 11px; vertical-alignment: center; }
                        }

                        if root.width < 1000px: VerticalBox {
                            spacing: 8px;

                            HorizontalLayout {
                                height: 98px;
                                spacing: 8px;
                                MetricPanel {
                                    horizontal-stretch: 1;
                                    title: root.overview-total-cpu-label;
                                    value: root.cpu-value;
                                    detail: root.cpu-status;
                                    accent: #7db6ff;
                                }
                                MetricPanel {
                                    horizontal-stretch: 1;
                                    title: root.overview-memory-label;
                                    value: root.memory-value;
                                    detail: root.memory-status;
                                    accent: #4fc59a;
                                }
                                MetricPanel {
                                    horizontal-stretch: 1;
                                    title: root.overview-swap-label;
                                    value: root.swap-value;
                                    detail: root.swap-status;
                                    accent: #b58cff;
                                }
                            }

                            HorizontalLayout {
                                height: 98px;
                                spacing: 8px;
                                MetricPanel {
                                    horizontal-stretch: 1;
                                    title: root.overview-processes-label;
                                    value: root.process-count;
                                    detail: root.process-count-detail;
                                    accent: #e8b75b;
                                }
                                MetricPanel {
                                    horizontal-stretch: 1;
                                    title: root.overview-battery-label;
                                    value: root.battery-value;
                                    detail: root.battery-status;
                                    accent: #e8b75b;
                                }
                            }
                        }

                        if root.width >= 1000px: HorizontalLayout {
                            height: 98px;
                            spacing: 10px;
                            MetricPanel {
                                horizontal-stretch: 1;
                                title: root.overview-total-cpu-label;
                                value: root.cpu-value;
                                detail: root.cpu-status;
                                accent: #7db6ff;
                            }
                            MetricPanel {
                                horizontal-stretch: 1;
                                title: root.overview-memory-label;
                                value: root.memory-value;
                                detail: root.memory-status;
                                accent: #4fc59a;
                            }
                            MetricPanel {
                                horizontal-stretch: 1;
                                title: root.overview-swap-label;
                                value: root.swap-value;
                                detail: root.swap-status;
                                accent: #b58cff;
                            }
                            MetricPanel {
                                horizontal-stretch: 1;
                                title: root.overview-processes-label;
                                value: root.process-count;
                                detail: root.process-count-detail;
                                accent: #e8b75b;
                            }
                            MetricPanel {
                                horizontal-stretch: 1;
                                title: root.overview-battery-label;
                                value: root.battery-value;
                                detail: root.battery-status;
                                accent: #e8b75b;
                            }
                        }

                        HorizontalLayout {
                            vertical-stretch: 1;
                            spacing: 12px;
                            cpu_chart := ChartPanel {
                                horizontal-stretch: 1;
                                title: root.overview-cpu-usage-label;
                                accessible-summary: root.cpu-history-accessible-summary;
                                points: root.cpu-history;
                                accent: #70b5ff;
                                range-start: root.cpu-history-start-label;
                                now-label: root.chart-now-label;
                                waiting-label: root.chart-waiting-label;
                            }
                            memory_chart := ChartPanel {
                                horizontal-stretch: 1;
                                title: root.overview-memory-usage-label;
                                accessible-summary: root.memory-history-accessible-summary;
                                points: root.memory-history;
                                accent: #50c99a;
                                range-start: root.memory-history-start-label;
                                now-label: root.chart-now-label;
                                waiting-label: root.chart-waiting-label;
                            }
                        }
                    }

                    if root.active-page == MainPage.processes: VerticalBox {
                        spacing: root.density == UiDensity.compact ? 7px : 12px;

                        HorizontalLayout {
                            height: 32px;
                            Text { text: root.nav-processes-label; accessible-label: root.nav-processes-label; color: #edf2f7; font-size: 19px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Text { text: root.process-count-description; accessible-label: root.process-count-description; color: #8493a5; font-size: 12px; vertical-alignment: center; }
                        }

                        Rectangle {
                            background: #19212b;
                            border-color: #2c3744;
                            border-width: 1px;
                            border-radius: 8px;
                            vertical-stretch: 1;

                            VerticalBox {
                                padding: root.density == UiDensity.compact ? 8px : 12px;
                                spacing: root.density == UiDensity.compact ? 5px : 8px;

                                HorizontalLayout {
                                    height: root.density == UiDensity.compact ? 30px : 38px;
                                    Text { text: root.process-list-title-label; accessible-label: root.process-list-title-label; color: #e4ebf3; font-size: 14px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    LineEdit {
                                        width: 238px;
                                        placeholder-text: root.process-filter-placeholder;
                                        accessible-label: root.process-filter-accessible-label;
                                        input-type: search;
                                        edited(text) => { root.filter-edited(text); }
                                    }
                                }

                                HorizontalLayout {
                                    height: root.density == UiDensity.compact ? 24px : 28px;
                                    spacing: 8px;
                                    SortHeader {
                                        horizontal-stretch: 1;
                                        label: root.process-column-label;
                                        key: "name";
                                        active-key: root.sort-key;
                                        descending: root.sort-descending;
                                        unsorted-description: root.process-sort-unsorted-description;
                                        ascending-description: root.process-sort-ascending-description;
                                        descending-description: root.process-sort-descending-description;
                                        requested(key) => { root.sort-requested(key); }
                                    }
                                    SortHeader {
                                        width: 58px;
                                        label: root.process-pid-label;
                                        key: "pid";
                                        active-key: root.sort-key;
                                        descending: root.sort-descending;
                                        unsorted-description: root.process-sort-unsorted-description;
                                        ascending-description: root.process-sort-ascending-description;
                                        descending-description: root.process-sort-descending-description;
                                        requested(key) => { root.sort-requested(key); }
                                    }
                                    SortHeader {
                                        width: 58px;
                                        label: root.process-parent-pid-label;
                                        key: "parent";
                                        active-key: root.sort-key;
                                        descending: root.sort-descending;
                                        unsorted-description: root.process-sort-unsorted-description;
                                        ascending-description: root.process-sort-ascending-description;
                                        descending-description: root.process-sort-descending-description;
                                        requested(key) => { root.sort-requested(key); }
                                    }
                                    SortHeader {
                                        width: 66px;
                                        label: root.process-cpu-label + " %";
                                        key: "cpu";
                                        active-key: root.sort-key;
                                        descending: root.sort-descending;
                                        unsorted-description: root.process-sort-unsorted-description;
                                        ascending-description: root.process-sort-ascending-description;
                                        descending-description: root.process-sort-descending-description;
                                        requested(key) => { root.sort-requested(key); }
                                    }
                                    SortHeader {
                                        width: 136px;
                                        label: root.process-memory-label + " " + (root.byte-unit-system == UiByteUnitSystem.si ? "MB" : "MiB") + " / %";
                                        key: "memory";
                                        active-key: root.sort-key;
                                        descending: root.sort-descending;
                                        unsorted-description: root.process-sort-unsorted-description;
                                        ascending-description: root.process-sort-ascending-description;
                                        descending-description: root.process-sort-descending-description;
                                        requested(key) => { root.sort-requested(key); }
                                    }
                                }

                                Rectangle {
                                    height: root.density == UiDensity.compact ? 44px : 54px;
                                    background: #121922;
                                    border-radius: 5px;
                                    if root.has-selected-process: VerticalBox {
                                        x: 10px;
                                        y: 6px;
                                        width: parent.width - 20px;
                                        height: parent.height - 12px;
                                        spacing: 3px;
                                        Text {
                                            text: root.selected-process-name + " · " + root.process-pid-label + " " + root.selected-process-pid + " · " + root.process-parent-pid-label + " " + root.selected-process-parent-pid;
                                            accessible-label: root.selected-process-name + " · " + root.process-pid-label + " " + root.selected-process-pid + " · " + root.process-parent-pid-label + " " + root.selected-process-parent-pid;
                                            color: #e4ebf3;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.process-started-label + " " + root.selected-process-started + " · " + root.process-cpu-label + " " + root.selected-process-cpu + " · " + root.process-memory-label + " " + root.selected-process-memory + " " + root.selected-process-memory-unit + " (" + root.selected-process-memory-percent + ")";
                                            accessible-label: root.process-started-label + " " + root.selected-process-started + " · " + root.process-cpu-label + " " + root.selected-process-cpu + " · " + root.process-memory-label + " " + root.selected-process-memory + " " + root.selected-process-memory-unit + " (" + root.selected-process-memory-percent + ")";
                                            color: #9eacbd;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                    if !root.has-selected-process: Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: parent.height;
                                        text: root.process-select-prompt-label;
                                        accessible-label: root.process-select-prompt-label;
                                        color: #8493a5;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.has-selected-process && root.process-control-supported: Rectangle {
                                    height: root.process-action-state == ProcessActionUiState.idle ? 42px : 68px;
                                    background: #19212b;
                                    border-color: #2c3744;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    VerticalBox {
                                        padding: 6px;
                                        spacing: 4px;
                                        if root.process-action-status != "": Text {
                                            text: root.process-action-status;
                                            accessible-label: root.process-action-status;
                                            color: #d6dee8;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                            if root.process-action-state == ProcessActionUiState.idle: ProcessActionButton {
                                                label: root.process-action-request-label;
                                                activated => { root.process-action-command("request-gentle"); }
                                            }
                                            if root.process-action-state == ProcessActionUiState.confirm_gentle: ProcessActionButton {
                                                label: root.process-action-confirm-label;
                                                activated => { root.process-action-command("confirm-gentle"); }
                                            }
                                            if root.process-action-state == ProcessActionUiState.confirm_gentle: ProcessActionButton {
                                                label: root.process-action-cancel-label;
                                                destructive: true;
                                                activated => { root.process-action-command("cancel"); }
                                            }
                                            if root.process-action-state == ProcessActionUiState.waiting_gentle: ProcessActionButton {
                                                label: root.process-action-stop-escalation-label;
                                                destructive: true;
                                                activated => { root.process-action-command("cancel"); }
                                            }
                                            if root.process-action-state == ProcessActionUiState.confirm_force: ProcessActionButton {
                                                label: root.process-action-force-label;
                                                destructive: true;
                                                activated => { root.process-action-command("confirm-force"); }
                                            }
                                            if root.process-action-state == ProcessActionUiState.confirm_force: ProcessActionButton {
                                                label: root.process-action-cancel-label;
                                                activated => { root.process-action-command("cancel"); }
                                            }
                                            if root.process-action-state == ProcessActionUiState.finished: ProcessActionButton {
                                                label: root.process-action-dismiss-label;
                                                activated => { root.process-action-command("dismiss"); }
                                            }
                                        }
                                    }
                                }

                                if root.has-selected-process: Rectangle {
                                    height: root.density == UiDensity.compact ? 96px : 124px;
                                    background: #19212b;
                                    border-color: #2c3744;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    VerticalBox {
                                        padding: 8px;
                                        spacing: 4px;
                                        Text {
                                            text: root.process-tree-title-label;
                                            accessible-label: root.process-tree-title-label;
                                            color: #e4ebf3;
                                            font-size: 12px;
                                        }
                                        if root.process-tree.length == 0: Text {
                                            text: root.process-tree-status;
                                            accessible-label: root.process-tree-status;
                                            color: #8493a5;
                                            font-size: 11px;
                                        }
                                        if root.process-tree.length > 0: ListView {
                                            vertical-stretch: 1;
                                            for item in root.process-tree: Text {
                                                x: item.depth * 14px;
                                                height: root.density == UiDensity.compact ? 16px : 20px;
                                                text: item.label;
                                                color: #a6b3c2;
                                                font-size: 11px;
                                            }
                                        }
                                    }
                                }

                                if root.processes.length == 0: Rectangle {
                                    vertical-stretch: 1;
                                    background: transparent;
                                    Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: root.agent-connected
                                            ? root.process-empty-filtered-label
                                            : root.process-waiting-connection-label;
                                        accessible-label: root.agent-connected
                                            ? root.process-empty-filtered-label
                                            : root.process-waiting-connection-label;
                                        color: #8493a5;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.processes.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for process in root.processes: Rectangle {
                                        height: root.density == UiDensity.compact ? 25px : 32px;
                                        accessible-role: list-item;
                                        accessible-label: process.name + ", " + root.process-pid-label + " " + process.pid + ", " + root.process-cpu-label + " " + process.cpu + ", " + root.process-memory-accessible-label + " " + process.memory + " " + process.memory-unit;
                                        accessible-item-selectable: true;
                                        accessible-item-selected: process.key == root.selected-process-key;
                                        accessible-action-default => { process-row-hit-target.clicked(); }
                                        background: process.key == root.selected-process-key ? #263a4c : transparent;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Rectangle {
                                                background: transparent;
                                                horizontal-stretch: 1;
                                                Text {
                                                    x: 0px;
                                                    width: parent.width;
                                                    height: parent.height;
                                                    text: process.name;
                                                    color: #e5ebf2;
                                                    font-size: 12px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                            Text { text: process.pid; color: #a6b3c2; width: 58px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                            Text { text: process.parent-pid; color: #a6b3c2; width: 58px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                            Text { text: process.cpu; color: #a6b3c2; width: 66px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                            Text { text: process.memory + " / " + process.memory-percent; color: #a6b3c2; width: 136px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                        }
                                        process-row-hit-target := TouchArea {
                                            clicked => {
                                                root.selected-process-key = process.key;
                                                root.has-selected-process = true;
                                                root.selected-process-name = process.name;
                                                root.selected-process-pid = process.pid;
                                                root.selected-process-parent-pid = process.parent-pid;
                                                root.selected-process-started = process.started;
                                                root.selected-process-cpu = process.cpu;
                                                root.selected-process-memory = process.memory;
                                                root.selected-process-memory-unit = process.memory-unit;
                                                root.selected-process-memory-percent = process.memory-percent;
                                                root.process-selected(process.key);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.active-page == MainPage.performance: VerticalBox {
                        spacing: 10px;

                        HorizontalLayout {
                            height: 34px;
                            Text { text: root.nav-performance-label; accessible-label: root.nav-performance-label; color: #edf2f7; font-size: 19px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            RangeChoice {
                                label: root.performance-one-minute-label;
                                active: root.history-range == HistoryRange.one-minute;
                                activated => {
                                    root.history-range = HistoryRange.one-minute;
                                    root.history-range-selected("one-minute");
                                }
                            }
                            RangeChoice {
                                label: root.performance-five-minutes-label;
                                active: root.history-range == HistoryRange.five-minutes;
                                activated => {
                                    root.history-range = HistoryRange.five-minutes;
                                    root.history-range-selected("five-minutes");
                                }
                            }
                        }

                        ChartPanel {
                            vertical-stretch: 1;
                            title: root.performance-cpu-total-label;
                            points: root.cpu-history;
                            accent: #70b5ff;
                            range-start: root.cpu-history-start-label;
                            now-label: root.chart-now-label;
                            waiting-label: root.chart-waiting-label;
                        }

                        ChartPanel {
                            vertical-stretch: 1;
                            title: root.performance-memory-used-label;
                            points: root.memory-history;
                            accent: #50c99a;
                            range-start: root.memory-history-start-label;
                            now-label: root.chart-now-label;
                            waiting-label: root.chart-waiting-label;
                        }

                        Rectangle {
                            height: 128px;
                            background: #19212b;
                            border-color: #2c3744;
                            border-width: 1px;
                            border-radius: 8px;
                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                Text { text: root.performance-cpu-per-core-label; accessible-label: root.performance-cpu-per-core-label; color: #e4ebf3; font-size: 13px; }
                                if root.cpu-cores.length == 0: Text {
                                    text: root.performance-cpu-unavailable-label;
                                    accessible-label: root.performance-cpu-unavailable-label;
                                    color: #8493a5;
                                    font-size: 12px;
                                }
                                if root.cpu-cores.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for core in root.cpu-cores: HorizontalLayout {
                                        height: 22px;
                                        spacing: 8px;
                                        Text { text: core.name; accessible-label: core.name; color: #a6b3c2; width: 62px; font-size: 11px; vertical-alignment: center; }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 7px;
                                            background: #10171f;
                                            border-radius: 4px;
                                            Rectangle {
                                                width: parent.width * core.fraction;
                                                height: parent.height;
                                                background: #70b5ff;
                                                border-radius: 4px;
                                            }
                                        }
                                        Text { text: core.usage; color: #a6b3c2; width: 54px; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 104px;
                            background: #19212b;
                            border-color: #2c3744;
                            border-width: 1px;
                            border-radius: 8px;
                            VerticalBox {
                                padding: 12px;
                                spacing: 6px;
                                Text { text: root.performance-gpu-vram-label; accessible-label: root.performance-gpu-vram-label; color: #e4ebf3; font-size: 13px; }
                                if root.gpus.length == 0: Text {
                                    text: root.gpu-status;
                                    accessible-label: root.gpu-status;
                                    color: #8493a5;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                if root.gpus.length > 0 && root.gpu-status != "": Text {
                                    text: root.gpu-status;
                                    accessible-label: root.gpu-status;
                                    color: #f0bd69;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                if root.gpus.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for gpu in root.gpus: HorizontalLayout {
                                        height: 22px;
                                        spacing: 8px;
                                        Text { text: gpu.name; color: #e5ebf2; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                        Text { text: gpu.utilization; color: #a6b3c2; font-size: 11px; width: 48px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: gpu.memory; color: #a6b3c2; font-size: 11px; width: 120px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: gpu.temperature; color: #a6b3c2; font-size: 11px; width: 58px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: gpu.clocks; color: #a6b3c2; font-size: 11px; width: 100px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: gpu.power; color: #a6b3c2; font-size: 11px; width: 52px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    if root.active-page == MainPage.storage: VerticalBox {
                        spacing: 12px;

                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            Text { text: root.nav-storage-label; accessible-label: root.nav-storage-label; color: #edf2f7; font-size: 19px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.volume-count; accessible-label: root.volume-count; color: #8493a5; font-size: 12px; vertical-alignment: center; }
                            Text { text: root.storage-units-label; accessible-label: root.storage-units-label; color: #8493a5; font-size: 11px; vertical-alignment: center; }
                            byte_units_si := RangeChoice {
                                width: 44px;
                                label: "SI";
                                active: root.byte-unit-system == UiByteUnitSystem.si;
                                accessible-label: root.storage-si-accessible-label;
                                activated => {
                                    root.byte-unit-system = UiByteUnitSystem.si;
                                    root.byte-unit-system-selected("si");
                                }
                            }
                            byte_units_iec := RangeChoice {
                                width: 44px;
                                label: "IEC";
                                active: root.byte-unit-system == UiByteUnitSystem.iec;
                                accessible-label: root.storage-iec-accessible-label;
                                activated => {
                                    root.byte-unit-system = UiByteUnitSystem.iec;
                                    root.byte-unit-system-selected("iec");
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: #19212b;
                            border-color: #2c3744;
                            border-width: 1px;
                            border-radius: 8px;

                            VerticalBox {
                                padding: 12px;
                                spacing: 8px;

                                HorizontalLayout {
                                    height: 28px;
                                    spacing: 8px;
                                    Text { text: root.storage-mount-point-label; accessible-label: root.storage-mount-point-label; color: #9eacbd; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.storage-read-label; accessible-label: root.storage-read-label; color: #9eacbd; font-size: 12px; width: 90px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: root.storage-write-label; accessible-label: root.storage-write-label; color: #9eacbd; font-size: 12px; width: 90px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: root.storage-file-system-label; accessible-label: root.storage-file-system-label; color: #9eacbd; font-size: 12px; width: 150px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: root.storage-available-label; accessible-label: root.storage-available-label; color: #9eacbd; font-size: 12px; width: 112px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: root.storage-total-label; accessible-label: root.storage-total-label; color: #9eacbd; font-size: 12px; width: 112px; horizontal-alignment: right; vertical-alignment: center; }
                                }

                                if root.volumes.length == 0: Text {
                                    vertical-stretch: 1;
                                    text: root.volume-status;
                                    accessible-label: root.volume-status;
                                    color: #8493a5;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                if root.volumes.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for volume in root.volumes: HorizontalLayout {
                                        height: 32px;
                                        spacing: 8px;
                                        Text { text: volume.mount-point; color: #e5ebf2; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                        Text { text: volume.read-rate; color: #a6b3c2; font-size: 12px; width: 90px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: volume.write-rate; color: #a6b3c2; font-size: 12px; width: 90px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: volume.file-system; color: #a6b3c2; font-size: 12px; width: 150px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                        Text { text: volume.available; color: #a6b3c2; font-size: 12px; width: 112px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: volume.total; color: #a6b3c2; font-size: 12px; width: 112px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: #19212b;
                            border-color: #2c3744;
                            border-width: 1px;
                            border-radius: 8px;

                            VerticalBox {
                                padding: 12px;
                                spacing: 8px;
                                Text { text: root.storage-block-activity-label; accessible-label: root.storage-block-activity-label; color: #e4ebf3; font-size: 13px; }

                                HorizontalLayout {
                                    height: 22px;
                                    spacing: 8px;
                                    Text { text: root.storage-device-label; accessible-label: root.storage-device-label; color: #9eacbd; font-size: 10px; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.storage-read-label; accessible-label: root.storage-read-label; color: #9eacbd; font-size: 10px; width: 92px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: root.storage-write-label; accessible-label: root.storage-write-label; color: #9eacbd; font-size: 10px; width: 92px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: root.storage-read-iops-label; accessible-label: root.storage-read-iops-label; color: #9eacbd; font-size: 10px; width: 74px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: root.storage-write-iops-label; accessible-label: root.storage-write-iops-label; color: #9eacbd; font-size: 10px; width: 74px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: root.storage-busy-label; accessible-label: root.storage-busy-label; color: #9eacbd; font-size: 10px; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                                }

                                if root.block-devices.length == 0: Text {
                                    vertical-stretch: 1;
                                    text: root.block-device-io-status;
                                    accessible-label: root.block-device-io-status;
                                    color: #8493a5;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                if root.block-devices.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for device in root.block-devices: HorizontalLayout {
                                        height: 30px;
                                        spacing: 8px;
                                        Text { text: device.name; color: #e5ebf2; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                                        Text { text: device.read-rate; color: #a6b3c2; font-size: 11px; width: 92px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: device.write-rate; color: #a6b3c2; font-size: 11px; width: 92px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: device.read-iops; color: #a6b3c2; font-size: 11px; width: 74px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: device.write-iops; color: #a6b3c2; font-size: 11px; width: 74px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: device.read-latency; color: #a6b3c2; font-size: 11px; width: 62px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: device.write-latency; color: #a6b3c2; font-size: 11px; width: 62px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: device.busy; color: #a6b3c2; font-size: 11px; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }

                    if root.active-page == MainPage.network: VerticalBox {
                        spacing: 12px;

                        HorizontalLayout {
                            height: 32px;
                            Text { text: root.nav-network-label; accessible-label: root.nav-network-label; color: #edf2f7; font-size: 19px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.network-interface-count; accessible-label: root.network-interface-count; color: #8493a5; font-size: 12px; vertical-alignment: center; }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: #19212b;
                            border-color: #2c3744;
                            border-width: 1px;
                            border-radius: 8px;

                            VerticalBox {
                                padding: 12px;
                                spacing: 8px;

                                HorizontalLayout {
                                    height: 28px;
                                    spacing: 8px;
                                    Text { text: root.network-interface-label; accessible-label: root.network-interface-label; color: #9eacbd; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.network-kind-label; accessible-label: root.network-kind-label; color: #9eacbd; font-size: 12px; width: 110px; vertical-alignment: center; }
                                    Text { text: root.network-received-label; accessible-label: root.network-received-label; color: #9eacbd; font-size: 12px; width: 140px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: root.network-sent-label; accessible-label: root.network-sent-label; color: #9eacbd; font-size: 12px; width: 140px; horizontal-alignment: right; vertical-alignment: center; }
                                }

                                if root.network-interfaces.length == 0: Text {
                                    vertical-stretch: 1;
                                    text: root.network-status;
                                    accessible-label: root.network-status;
                                    color: #8493a5;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                if root.network-interfaces.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for interface in root.network-interfaces: HorizontalLayout {
                                        height: 32px;
                                        spacing: 8px;
                                        accessible-role: list-item;
                                        accessible-label: interface.name + ", " + interface.kind;
                                        Text { text: interface.name; color: #e5ebf2; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                        Text { text: interface.kind; color: #a6b3c2; font-size: 12px; width: 110px; vertical-alignment: center; }
                                        Text { text: interface.received; color: #a6b3c2; font-size: 12px; width: 140px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: interface.transmitted; color: #a6b3c2; font-size: 12px; width: 140px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
