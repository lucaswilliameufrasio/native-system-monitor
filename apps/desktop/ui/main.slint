import { LineEdit, ListView, VerticalBox } from "std-widgets.slint";

export struct ProcessRow {
    key: string,
    name: string,
    pid: string,
    parent-pid: string,
    started: string,
    cpu: string,
    memory: string,
    memory-percent: string,
}

export struct CpuCoreRow {
    name: string,
    usage: string,
    fraction: float,
}

export struct VolumeRow {
    mount-point: string,
    file-system: string,
    total: string,
    available: string,
}

export struct NetworkInterfaceRow {
    name: string,
    received: string,
    transmitted: string,
}

export struct BlockDeviceRow {
    name: string,
    read-rate: string,
    write-rate: string,
    read-iops: string,
    write-iops: string,
    busy: string,
}

enum MainPage { overview, processes, performance, storage, network }
enum HistoryRange { one-minute, five-minutes }

component MetricPanel inherits Rectangle {
    min-width: 0px;
    in property <string> title;
    in property <string> value;
    in property <string> detail;
    in property <color> accent;
    background: #19212b;
    border-color: #2c3744;
    border-width: 1px;
    border-radius: 8px;

    VerticalBox {
        padding: 14px;
        spacing: 5px;
        Text { text: title; color: #9eacbd; font-size: 13px; }
        Text { text: value; color: accent; font-size: 22px; }
        Text { text: detail; color: #8493a5; font-size: 12px; overflow: elide; }
    }
}

component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback activated();
    height: 42px;
    border-radius: 6px;
    background: active ? #263a4c : transparent;

    Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: label;
        color: active ? #eaf3fc : #a6b3c2;
        font-size: 14px;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.activated(); } }
}

component RangeChoice inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback activated();
    width: 72px;
    height: 30px;
    border-radius: 5px;
    background: active ? #28425a : #19212b;
    border-color: active ? #47749a : #2c3744;
    border-width: 1px;

    Text {
        width: parent.width;
        height: parent.height;
        text: label;
        color: active ? #edf6ff : #a6b3c2;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.activated(); } }
}

component SortHeader inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <string> active-key;
    in property <bool> descending;
    callback requested(string);
    min-width: 0px;
    height: 28px;
    background: transparent;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label + (root.active-key == root.key ? (root.descending ? "  ↓" : "  ↑") : "");
        color: root.active-key == root.key ? #dce9f6 : #9eacbd;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: root.key == "name" ? left : right;
        overflow: elide;
    }
    TouchArea { clicked => { root.requested(root.key); } }
}

component ChartPanel inherits Rectangle {
    min-width: 0px;
    in property <string> title;
    in property <[float]> points;
    in property <color> accent;
    in property <string> range-start;
    background: #19212b;
    border-color: #2c3744;
    border-width: 1px;
    border-radius: 8px;

    VerticalBox {
        padding: 14px;
        spacing: 8px;

        HorizontalLayout {
            height: 24px;
            Text { text: title; color: #e4ebf3; font-size: 14px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: "%"; color: #8b9aae; font-size: 12px; vertical-alignment: center; }
        }

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            VerticalBox {
                width: 34px;
                Text { text: "100"; color: #8190a2; font-size: 10px; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: "50"; color: #8190a2; font-size: 10px; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text { text: "0"; color: #8190a2; font-size: 10px; }
            }

            Rectangle {
                background: #121922;
                border-radius: 4px;
                horizontal-stretch: 1;
                vertical-stretch: 1;

                if points.length == 0: Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Aguardando amostras";
                    color: #8493a5;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if points.length > 0: HorizontalLayout {
                    x: 5px;
                    y: 5px;
                    width: parent.width - 10px;
                    height: parent.height - 10px;
                    spacing: 2px;
                    for point in points: Rectangle {
                        min-width: 1px;
                        horizontal-stretch: 1;
                        height: parent.height;
                        background: transparent;
                        Rectangle {
                            y: parent.height * (1 - point / 100);
                            width: parent.width;
                            height: parent.height * point / 100;
                            background: accent;
                            border-radius: 2px;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 18px;
            Text { text: range-start; color: #8190a2; font-size: 10px; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: "agora"; color: #8190a2; font-size: 10px; }
        }
    }
}

export component MainWindow inherits Window {
    title: "Monitor do Sistema";
    width: 1120px;
    height: 760px;
    background: #11161d;

    in-out property <string> agent-status: "Conectando ao agente…";
    in-out property <bool> agent-connected: false;
    in-out property <bool> agent-startup-configured: false;
    in-out property <string> sample-age: "Aguardando amostra";
    in-out property <string> cpu-value: "—";
    in-out property <string> cpu-status: "Aguardando primeira amostra";
    in-out property <string> memory-value: "—";
    in-out property <string> memory-status: "Aguardando primeira amostra";
    in-out property <string> swap-value: "—";
    in-out property <string> swap-status: "Aguardando primeira amostra";
    in-out property <string> process-count: "—";
    in-out property <string> sort-key: "cpu";
    in-out property <bool> sort-descending: true;
    in-out property <string> cpu-history-start-label: "início";
    in-out property <string> memory-history-start-label: "início";
    in-out property <string> selected-process-key: "";
    in-out property <bool> has-selected-process: false;
    in-out property <string> selected-process-name: "";
    in-out property <string> selected-process-pid: "—";
    in-out property <string> selected-process-parent-pid: "—";
    in-out property <string> selected-process-started: "—";
    in-out property <string> selected-process-cpu: "—";
    in-out property <string> selected-process-memory: "—";
    in-out property <string> selected-process-memory-percent: "—";
    in-out property <[ProcessRow]> processes: [];
    in-out property <[CpuCoreRow]> cpu-cores: [];
    in-out property <[VolumeRow]> volumes: [];
    in-out property <string> volume-status: "Aguardando conexão com o agente…";
    in-out property <[NetworkInterfaceRow]> network-interfaces: [];
    in-out property <string> network-status: "Aguardando conexão com o agente…";
    in-out property <[BlockDeviceRow]> block-devices: [];
    in-out property <string> block-device-io-status: "Aguardando conexão com o agente…";
    in-out property <[float]> cpu-history: [];
    in-out property <[float]> memory-history: [];
    in-out property <MainPage> active-page: MainPage.overview;
    in-out property <HistoryRange> history-range: HistoryRange.five-minutes;
    callback filter-edited(string);
    callback sort-requested(string);
    callback process-selected(string);
    callback history-range-selected(string);
    callback retry-agent();

    VerticalBox {
        padding: 18px;
        spacing: 14px;

        HorizontalLayout {
            height: 54px;
            spacing: 14px;

            VerticalBox {
                width: 220px;
                spacing: 2px;
                Text { text: "Monitor do Sistema"; color: #edf2f7; font-size: 23px; }
                Text { text: "Visibilidade clara do seu computador"; color: #8493a5; font-size: 11px; }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            VerticalBox {
                width: 280px;
                spacing: 2px;
                Text {
                    text: agent-status;
                    color: agent-connected && agent-startup-configured ? #77d7ad : #f0bd69;
                    font-size: 12px;
                    horizontal-alignment: right;
                    overflow: elide;
                }
                Text {
                    text: sample-age;
                    color: #8493a5;
                    font-size: 11px;
                    horizontal-alignment: right;
                }
            }

            if !agent-connected || !agent-startup-configured: RangeChoice {
                width: 136px;
                label: agent-connected ? "Configurar início" : "Tentar conexão";
                active: false;
                activated => { root.retry-agent(); }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;

            Rectangle {
                width: 164px;
                background: #171e27;
                border-color: #26313d;
                border-width: 1px;
                border-radius: 8px;

                VerticalBox {
                    padding: 10px;
                    spacing: 6px;
                    Text { text: "MONITORAMENTO"; color: #718197; font-size: 10px; }
                    NavigationItem {
                        label: "Visão geral";
                        active: root.active-page == MainPage.overview;
                        activated => { root.active-page = MainPage.overview; }
                    }
                    NavigationItem {
                        label: "Processos";
                        active: root.active-page == MainPage.processes;
                        activated => { root.active-page = MainPage.processes; }
                    }
                    NavigationItem {
                        label: "Desempenho";
                        active: root.active-page == MainPage.performance;
                        activated => { root.active-page = MainPage.performance; }
                    }
                    NavigationItem {
                        label: "Armazenamento";
                        active: root.active-page == MainPage.storage;
                        activated => { root.active-page = MainPage.storage; }
                    }
                    NavigationItem {
                        label: "Rede";
                        active: root.active-page == MainPage.network;
                        activated => { root.active-page = MainPage.network; }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text {
                        text: "A coleta continua\ncom a janela fechada";
                        color: #718197;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                if root.active-page == MainPage.overview: VerticalBox {
                    spacing: 12px;

                    HorizontalLayout {
                        height: 30px;
                        Text { text: "Visão geral"; color: #edf2f7; font-size: 19px; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: "Atualização contínua"; color: #8493a5; font-size: 11px; vertical-alignment: center; }
                    }

                    HorizontalLayout {
                        height: 98px;
                        spacing: 10px;
                        MetricPanel {
                            horizontal-stretch: 1;
                            title: "CPU total";
                            value: root.cpu-value;
                            detail: root.cpu-status;
                            accent: #7db6ff;
                        }
                        MetricPanel {
                            horizontal-stretch: 1;
                            title: "Memória";
                            value: root.memory-value;
                            detail: root.memory-status;
                            accent: #4fc59a;
                        }
                        MetricPanel {
                            horizontal-stretch: 1;
                            title: "Swap";
                            value: root.swap-value;
                            detail: root.swap-status;
                            accent: #b58cff;
                        }
                        MetricPanel {
                            horizontal-stretch: 1;
                            title: "Processos";
                            value: root.process-count;
                            detail: "visíveis nesta amostra";
                            accent: #e8b75b;
                        }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 12px;
                        ChartPanel {
                            horizontal-stretch: 1;
                            title: "Uso de CPU";
                            points: root.cpu-history;
                            accent: #70b5ff;
                            range-start: root.cpu-history-start-label;
                        }
                        ChartPanel {
                            horizontal-stretch: 1;
                            title: "Uso de memória";
                            points: root.memory-history;
                            accent: #50c99a;
                            range-start: root.memory-history-start-label;
                        }
                    }
                }

                if root.active-page == MainPage.processes: VerticalBox {
                    spacing: 12px;

                    HorizontalLayout {
                        height: 32px;
                        Text { text: "Processos"; color: #edf2f7; font-size: 19px; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: root.process-count + " visíveis"; color: #8493a5; font-size: 12px; vertical-alignment: center; }
                    }

                    Rectangle {
                        background: #19212b;
                        border-color: #2c3744;
                        border-width: 1px;
                        border-radius: 8px;
                        vertical-stretch: 1;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                height: 38px;
                                Text { text: "Lista de processos"; color: #e4ebf3; font-size: 14px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                LineEdit {
                                    width: 238px;
                                    placeholder-text: "Filtrar por nome ou PID";
                                    input-type: search;
                                    edited(text) => { root.filter-edited(text); }
                                }
                            }

                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                SortHeader {
                                    horizontal-stretch: 1;
                                    label: "Processo";
                                    key: "name";
                                    active-key: root.sort-key;
                                    descending: root.sort-descending;
                                    requested(key) => { root.sort-requested(key); }
                                }
                                SortHeader {
                                    width: 58px;
                                    label: "PID";
                                    key: "pid";
                                    active-key: root.sort-key;
                                    descending: root.sort-descending;
                                    requested(key) => { root.sort-requested(key); }
                                }
                                SortHeader {
                                    width: 58px;
                                    label: "PPID";
                                    key: "parent";
                                    active-key: root.sort-key;
                                    descending: root.sort-descending;
                                    requested(key) => { root.sort-requested(key); }
                                }
                                SortHeader {
                                    width: 66px;
                                    label: "CPU %";
                                    key: "cpu";
                                    active-key: root.sort-key;
                                    descending: root.sort-descending;
                                    requested(key) => { root.sort-requested(key); }
                                }
                                SortHeader {
                                    width: 136px;
                                    label: "RAM MiB / %";
                                    key: "memory";
                                    active-key: root.sort-key;
                                    descending: root.sort-descending;
                                    requested(key) => { root.sort-requested(key); }
                                }
                            }

                            Rectangle {
                                height: 54px;
                                background: #121922;
                                border-radius: 5px;
                                if root.has-selected-process: VerticalBox {
                                    x: 10px;
                                    y: 6px;
                                    width: parent.width - 20px;
                                    height: parent.height - 12px;
                                    spacing: 3px;
                                    Text {
                                        text: root.selected-process-name + " · PID " + root.selected-process-pid + " · PPID " + root.selected-process-parent-pid;
                                        color: #e4ebf3;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "Início: " + root.selected-process-started + " · CPU " + root.selected-process-cpu + " · RAM " + root.selected-process-memory + " MiB (" + root.selected-process-memory-percent + ")";
                                        color: #9eacbd;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                                if !root.has-selected-process: Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    text: "Selecione um processo para ver PID, início e consumo.";
                                    color: #8493a5;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            if root.processes.length == 0: Rectangle {
                                vertical-stretch: 1;
                                background: transparent;
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.agent-connected ? "Nenhum processo corresponde ao filtro." : "Aguardando conexão com o agente…";
                                    color: #8493a5;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            if root.processes.length > 0: ListView {
                                vertical-stretch: 1;
                                for process in root.processes: Rectangle {
                                    height: 32px;
                                    background: process.key == root.selected-process-key ? #263a4c : transparent;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Rectangle {
                                            background: transparent;
                                            horizontal-stretch: 1;
                                            Text {
                                                x: 0px;
                                                width: parent.width;
                                                height: parent.height;
                                                text: process.name;
                                                color: #e5ebf2;
                                                font-size: 12px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        Text { text: process.pid; color: #a6b3c2; width: 58px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: process.parent-pid; color: #a6b3c2; width: 58px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: process.cpu; color: #a6b3c2; width: 66px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: process.memory + " / " + process.memory-percent; color: #a6b3c2; width: 136px; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                    process-row-hit-target := TouchArea {
                                        clicked => {
                                            root.selected-process-key = process.key;
                                            root.has-selected-process = true;
                                            root.selected-process-name = process.name;
                                            root.selected-process-pid = process.pid;
                                            root.selected-process-parent-pid = process.parent-pid;
                                            root.selected-process-started = process.started;
                                            root.selected-process-cpu = process.cpu;
                                            root.selected-process-memory = process.memory;
                                            root.selected-process-memory-percent = process.memory-percent;
                                            root.process-selected(process.key);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.active-page == MainPage.performance: VerticalBox {
                    spacing: 10px;

                    HorizontalLayout {
                        height: 34px;
                        Text { text: "Desempenho"; color: #edf2f7; font-size: 19px; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        RangeChoice {
                            label: "1 minuto";
                            active: root.history-range == HistoryRange.one-minute;
                            activated => {
                                root.history-range = HistoryRange.one-minute;
                                root.history-range-selected("one-minute");
                            }
                        }
                        RangeChoice {
                            label: "5 minutos";
                            active: root.history-range == HistoryRange.five-minutes;
                            activated => {
                                root.history-range = HistoryRange.five-minutes;
                                root.history-range-selected("five-minutes");
                            }
                        }
                    }

                    ChartPanel {
                        vertical-stretch: 1;
                        title: "CPU total";
                        points: root.cpu-history;
                        accent: #70b5ff;
                        range-start: root.cpu-history-start-label;
                    }

                    ChartPanel {
                        vertical-stretch: 1;
                        title: "Memória usada";
                        points: root.memory-history;
                        accent: #50c99a;
                        range-start: root.memory-history-start-label;
                    }

                    Rectangle {
                        height: 128px;
                        background: #19212b;
                        border-color: #2c3744;
                        border-width: 1px;
                        border-radius: 8px;
                        VerticalBox {
                            padding: 12px;
                            spacing: 6px;
                            Text { text: "CPU por núcleo"; color: #e4ebf3; font-size: 13px; }
                            if root.cpu-cores.length == 0: Text {
                                text: "Dados por núcleo indisponíveis nesta amostra.";
                                color: #8493a5;
                                font-size: 12px;
                            }
                            if root.cpu-cores.length > 0: ListView {
                                vertical-stretch: 1;
                                for core in root.cpu-cores: HorizontalLayout {
                                    height: 22px;
                                    spacing: 8px;
                                    Text { text: core.name; color: #a6b3c2; width: 62px; font-size: 11px; vertical-alignment: center; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 7px;
                                        background: #10171f;
                                        border-radius: 4px;
                                        Rectangle {
                                            width: parent.width * core.fraction;
                                            height: parent.height;
                                            background: #70b5ff;
                                            border-radius: 4px;
                                        }
                                    }
                                    Text { text: core.usage; color: #a6b3c2; width: 54px; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                if root.active-page == MainPage.storage: VerticalBox {
                    spacing: 12px;

                    HorizontalLayout {
                        height: 32px;
                        Text { text: "Armazenamento"; color: #edf2f7; font-size: 19px; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: root.volumes.length + " volumes"; color: #8493a5; font-size: 12px; vertical-alignment: center; }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: #19212b;
                        border-color: #2c3744;
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                Text { text: "Ponto de montagem"; color: #9eacbd; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: "Sistema de arquivos"; color: #9eacbd; font-size: 12px; width: 150px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: "Disponível"; color: #9eacbd; font-size: 12px; width: 112px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: "Total"; color: #9eacbd; font-size: 12px; width: 112px; horizontal-alignment: right; vertical-alignment: center; }
                            }

                            if root.volumes.length == 0: Text {
                                vertical-stretch: 1;
                                text: root.volume-status;
                                color: #8493a5;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if root.volumes.length > 0: ListView {
                                vertical-stretch: 1;
                                for volume in root.volumes: HorizontalLayout {
                                    height: 32px;
                                    spacing: 8px;
                                    Text { text: volume.mount-point; color: #e5ebf2; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    Text { text: volume.file-system; color: #a6b3c2; font-size: 12px; width: 150px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                    Text { text: volume.available; color: #a6b3c2; font-size: 12px; width: 112px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: volume.total; color: #a6b3c2; font-size: 12px; width: 112px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: #19212b;
                        border-color: #2c3744;
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;
                            Text { text: "Atividade por dispositivo de bloco (Linux)"; color: #e4ebf3; font-size: 13px; }

                            HorizontalLayout {
                                height: 22px;
                                spacing: 8px;
                                Text { text: "Dispositivo"; color: #9eacbd; font-size: 10px; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: "Leitura"; color: #9eacbd; font-size: 10px; width: 92px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: "Escrita"; color: #9eacbd; font-size: 10px; width: 92px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: "Read IOPS"; color: #9eacbd; font-size: 10px; width: 74px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: "Write IOPS"; color: #9eacbd; font-size: 10px; width: 74px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: "Busy"; color: #9eacbd; font-size: 10px; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                            }

                            if root.block-devices.length == 0: Text {
                                vertical-stretch: 1;
                                text: root.block-device-io-status;
                                color: #8493a5;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if root.block-devices.length > 0: ListView {
                                vertical-stretch: 1;
                                for device in root.block-devices: HorizontalLayout {
                                    height: 30px;
                                    spacing: 8px;
                                    Text { text: device.name; color: #e5ebf2; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: device.read-rate; color: #a6b3c2; font-size: 11px; width: 92px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: device.write-rate; color: #a6b3c2; font-size: 11px; width: 92px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: device.read-iops; color: #a6b3c2; font-size: 11px; width: 74px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: device.write-iops; color: #a6b3c2; font-size: 11px; width: 74px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: device.busy; color: #a6b3c2; font-size: 11px; width: 64px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                if root.active-page == MainPage.network: VerticalBox {
                    spacing: 12px;

                    HorizontalLayout {
                        height: 32px;
                        Text { text: "Rede"; color: #edf2f7; font-size: 19px; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: root.network-interfaces.length + " interfaces"; color: #8493a5; font-size: 12px; vertical-alignment: center; }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: #19212b;
                        border-color: #2c3744;
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                Text { text: "Interface"; color: #9eacbd; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: "Recebimento"; color: #9eacbd; font-size: 12px; width: 140px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: "Envio"; color: #9eacbd; font-size: 12px; width: 140px; horizontal-alignment: right; vertical-alignment: center; }
                            }

                            if root.network-interfaces.length == 0: Text {
                                vertical-stretch: 1;
                                text: root.network-status;
                                color: #8493a5;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            if root.network-interfaces.length > 0: ListView {
                                vertical-stretch: 1;
                                for interface in root.network-interfaces: HorizontalLayout {
                                    height: 32px;
                                    spacing: 8px;
                                    Text { text: interface.name; color: #e5ebf2; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    Text { text: interface.received; color: #a6b3c2; font-size: 12px; width: 140px; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: interface.transmitted; color: #a6b3c2; font-size: 12px; width: 140px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
